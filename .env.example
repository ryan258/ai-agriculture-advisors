# OpenRouter API Configuration
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=your_model_id_here
# Optional: use a separate model for roundtable synthesis only.
# OPENROUTER_SYNTHESIS_MODEL=your_synthesis_model_id_here
# Choose model IDs available to your OpenRouter account: https://openrouter.ai/models
# Provider availability, supported response formats, and pricing can change.

# Server Configuration
PORT=8123

# Storage Configuration
# Relative paths resolve from the project, even when a launcher is called elsewhere.
CHROMADB_PATH=.chromadb

# Deliberate work bounds. Each provider dispatch, including fallbacks, uses one call.
MAX_OUTPUT_TOKENS=1800
MAX_RUN_CALLS=32
MAX_RUN_SECONDS=600
MAX_PROMPT_CHARS=120000
MAX_RUN_ATTEMPTS=3

# Development Overrides
# Set to true to allow startup without OPENROUTER_API_KEY (useful for tests)
ALLOW_MISSING_API_KEY=false
